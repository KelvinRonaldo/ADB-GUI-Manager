{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Só o que a interface usa. Arquivos do computador passam pelos comandos do app, que recebem caminhos escolhidos nos diálogos.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-set-theme",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-confirm",
    "opener:allow-open-url",
    "opener:allow-reveal-item-in-dir"
  ]
}